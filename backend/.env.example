APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
REDIS_URL=
# 自动化测试专用：仅指向本地或 CI 临时服务，不得复用生产连接。
TEST_DATABASE_URL=
TEST_REDIS_URL=
# 低频兼容性 Smoke 专用：仅指向独立、可自动清理的测试实例。
SMOKE_DATABASE_URL=
SMOKE_REDIS_URL=
WORKFLOW_CHECKPOINTER=memory
JWT_SECRET=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=competitor-analysis
# 开启 LangSmith tracing 时必须同时填写 LANGCHAIN_API_KEY；CI / 默认本地保持 false。
EMBEDDING_MODEL=text-embedding-3-small
# 立项模型：调试用 gpt-4o-mini（便宜、迭代快）；提交评委前改为 gpt-4.1
# （推荐，质量/延迟/成本最佳交叉点）。GPT-5 级在“立项”这一步边际收益小、
# 延迟更高，不建议，把它留给后续 Analyst/Writer 的长篇深度环节。
SCOPING_MODEL=gpt-4o-mini
