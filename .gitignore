# Environment variables
.env
.env.local
.env.*.local
.env.production.local

# Plans and internal documentation
/plans/

# Claude Code local state
.claude/

# Note: apps/ subdirs (apps/web/, apps/api/) have their own .gitignore that
# handles node_modules/build artifacts. The /apps/ blanket-ignore that was
# here earlier was a mistake — it hid all real frontend code.

# API keys and secrets
**/api_key*
**/*secret*
**/*token*
**/*.key
**/*.pem

# Node modules
node_modules/
package-lock.json
yarn.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output
dist/
build/
.next/
out/

# Dependencies
node_modules/
venv/
__pycache__/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
