# Environment variables — broadened to cover .env.development / .env.production
# (单文件根 .gitignore 唯一事实源；apps/ 子目录不再各自 .gitignore)
.env
.env*
!.env.example
!**/.env.example

# Plans and internal documentation
/plans/

# Claude Code local state
.claude/
.superpowers/

# Editor caches
.eslintcache

# API keys and secrets
**/api_key*
**/*secret*
**/*token*
**/*.key
**/*.pem
# 白名单：design-tokens.md 是 CSS design tokens 文档，被 **/*token* 误伤
!**/design-tokens.md

# Node modules
node_modules/
# package-lock.json 必须入库 —— 单人 3 周比赛，部署到 Railway / 评委 clone 后
# `npm install` 必须装到一致版本；lock 几 MB 对 git 不算负担
yarn.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output
dist/
build/
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts

# Test coverage
coverage/

# Dependencies
node_modules/
venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
